# Copy to .env next to docker-compose.yml and adjust.
WP_DIR=/volume1/web/wordpress
# Web Station's web user on DSM (http). Check with: id http
WEB_UID=1023
WEB_GID=1023
# Local port the container listens on (only 127.0.0.1)
HOST_PORT=8083
# Folder that holds the MariaDB 10 socket used in wp-config.php (localhost:/run/mysqld/mysqld10.sock)
MYSQL_SOCKET_DIR=/run/mysqld
TZ=Asia/Seoul
